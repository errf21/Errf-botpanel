# Copy to .dev.vars for local development. NEVER commit real values.
# Local dev only; in production use `wrangler secret put <NAME>`.

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Random string you choose; Telegram echoes it in the X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=

# PasarGuard panel API key (Phase 5). Created in the panel's admin UI
# (API keys); sent ONLY as the X-Api-Key header over HTTPS. Provisioning is a
# strict no-op while this is empty — approvals then just park orders in
# 'approved' until a key + settings row 'provisioning' exist.
PASARGUARD_API_KEY=

# Seller card number (Phase 8C). The ONLY source of the card shown in payment
# instructions — never the settings doc, never code, never committed.
# Production: npx wrangler secret put PAYMENT_CARD_NUMBER
PAYMENT_CARD_NUMBER=
